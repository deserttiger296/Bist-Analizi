# BIST-Analyst Environment Variables

# Required: AI Analysis Engine (choose one or both)
# Primary: Google Gemini (Firebase ML Motor)
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Fallback: Claude API for AI analysis & sentiment
ANTHROPIC_API_KEY=sk-ant-xxxxx

# News Sources (try in order: Finnhub → NewsAPI → Twelve Data)
# If none set, demo verdicts will be shown instead

# Finnhub: Best Turkish/BIST support (60 API calls/min)
# Free tier: https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_key_here

# NewsAPI: Broad news coverage (100 requests/day)
# Free tier: https://newsapi.org/
NEWSAPI_KEY=your_newsapi_key_here

# Twelve Data: Stock-focused news (800 API calls/day)
# Free tier: https://twelvedata.com/
TWELVEDATA_API_KEY=your_twelvedata_key_here

# Firebase (if using)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Calibration Engine (Adaptive Weight Recalibration)
GOOGLE_AI_API_KEY=your_google_ai_key_for_gemini
QSTASH_CURRENT_SIGNING_KEY=your_qstash_signing_key
QSTASH_NEXT_SIGNING_KEY=your_qstash_next_signing_key
BACKTEST_WINDOW_DAYS=5
RETENTION_DAYS=30

# Firebase Admin SDK (Server-side, for Firestore writes)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_PRIVATE_KEY=your_private_key

# Python Quant Engine (FastAPI service in python_bot/, run separately via
# `.venv/Scripts/python.exe -m uvicorn main:app --port 8000` from python_bot/).
# Optional: if unreachable, callers fall back gracefully (see src/lib/pythonEngine.ts).
PYTHON_ENGINE_URL=http://localhost:8000

# StockSharp indicator service (ASP.NET Core, run via `dotnet run` from
# stocksharp-service/, default port 5007). Used by src/app/api/bist/indicators.
STOCKSHARP_URL=http://localhost:5007

# Required in production: shared secret for GET-triggered cron routes
# (kap-sentiment, qp-scan, scalper, smart-stop). The scheduler must send
# `Authorization: Bearer <CRON_SECRET>`; requests are rejected if this is unset.
CRON_SECRET=

# Postgres connection string (Firebase Data Connect), used by src/lib/db.ts
POSTGRES_URL=
